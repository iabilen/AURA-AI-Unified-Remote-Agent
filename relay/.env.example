# MCP clients use this token for /mcp. Keep it >= 24 chars.
AURA_MCP_TOKEN=replace-with-a-long-random-secret

# JSON map of deviceId -> token. During bootstrap, "*" may be used.
# Production should replace "*" with the paired device UUID.
AURA_DEVICE_TOKENS={"*":"replace-with-a-long-device-secret"}

PORT=8787
